# Local mode is self-contained and stores data only under PII_DATA_DIR.
PII_RUNTIME=local
PII_DATA_DIR=./data
PII_PUBLIC_BASE_URL=http://localhost:8080
PII_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Replace this with at least 32 random characters. Never commit the real value.
PII_TOKEN_PEPPER=replace-with-a-random-secret-at-least-32-characters
PII_TOKEN_PEPPER_SECRET_ARN=

# Retention and abuse controls. These are the only product limits.
PII_RETENTION_HOURS=1
PII_RETENTION_CLEANUP_MARGIN_MINUTES=5
PII_MAX_UPLOAD_BYTES=52428800
PII_MAX_PAGES=300
PII_MAX_JOBS_PER_IP_PER_HOUR=100
PII_MAX_ACTIVE_JOBS_PER_IP=5
PII_MAX_QUEUE_DEPTH=500

# Text-anchored detection worker. The worker launches a loopback-only vLLM
# server for the pinned model; boxes come from PDF/OCR word geometry.
PII_MODEL_ID=google/gemma-4-E2B-it
PII_MODEL_REVISION=3e22461f65e89153144f8adb70e3b8c2cc9845a7
PII_MODEL_MAX_NEW_TOKENS=1500
PII_VLLM_LAUNCH=true
PII_VLLM_PORT=8000
PII_VLLM_MAX_MODEL_LEN=16384
PII_VLLM_GPU_MEMORY_UTILIZATION=0.90
PII_VLLM_STARTUP_TIMEOUT_SECONDS=600
PII_DETECTOR_CONCURRENCY=8
PII_DOCUMENT_CONCURRENCY=3
PII_RENDER_DPI=200
PII_OCR_ENABLED=true
PII_WORKER_POLL_SECONDS=2

# AWS mode only. Values are supplied by the deployment stack.
PII_AWS_REGION=us-east-1
PII_S3_BUCKET=
PII_DYNAMODB_TABLE=
PII_SQS_QUEUE_URL=
